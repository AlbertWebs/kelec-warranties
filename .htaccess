<IfModule mod_rewrite.c>
    RewriteEngine On

    # Remove /public from the browser URL (301)
    RewriteCond %{THE_REQUEST} \s/+public/([^\s?]*) [NC]
    RewriteRule ^ /%1 [L,R=301,NE,QSA]

    RewriteCond %{THE_REQUEST} \s/+public[\s?] [NC]
    RewriteRule ^ / [L,R=301,QSA]

    # Internally route all requests through Laravel's public folder
    RewriteRule ^$ public/ [L]
    RewriteRule ^((?!public/).*)$ public/$1 [L]
</IfModule>

<FilesMatch "^\.env">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>
